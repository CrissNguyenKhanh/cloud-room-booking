# Copy to .env for local development. All values below are development-only placeholders.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

POSTGRES_DB=cloud_room
POSTGRES_ADMIN_USER=cloud_admin
POSTGRES_ADMIN_PASSWORD=change-local-admin-password
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=change-local-identity-password
BOOKING_DB_USER=booking_app
BOOKING_DB_PASSWORD=change-local-booking-password
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-local-notification-password

IDENTITY_DATABASE_URL=postgresql://identity_app:change-local-identity-password@postgres:5432/cloud_room
BOOKING_DATABASE_URL=postgresql://booking_app:change-local-booking-password@postgres:5432/cloud_room
NOTIFICATION_DATABASE_URL=postgresql://notification_app:change-local-notification-password@postgres:5432/cloud_room

# Use long, independently generated values outside local development.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=cloud-room-identity
JWT_AUDIENCE=cloud-room-services
JWT_EXPIRES_IN=1h
INTERNAL_SERVICE_KEY=replace-with-a-long-random-service-key

IDENTITY_SERVICE_URL=http://identity-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
IDENTITY_TIMEOUT_MS=2000
NOTIFICATION_TIMEOUT_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=20

# Optional. Leave blank to skip creating the initial administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
