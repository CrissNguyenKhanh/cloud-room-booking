NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

LOCAL_NEON_DATABASE_URL=

# Optional service-specific DB overrides
# IDENTITY_DATABASE_URL=
# BOOKING_DATABASE_URL=
# NOTIFICATION_DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=local-dev-issuer
JWT_AUDIENCE=local-dev-audience
JWT_EXPIRES_IN=1h

INTERNAL_SERVICE_KEY=replace-with-a-local-service-key-at-least-24-chars

IDENTITY_TIMEOUT_MS=2000
NOTIFICATION_TIMEOUT_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=20
